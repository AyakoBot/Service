//#region IGNORE

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

//#endregion

model AfkState {
 user   String  @db.VarChar
 reason String?
 since  Decimal @db.Decimal
 guild  String  @db.VarChar

 @@id([user, guild])
 @@index([user, guild])
}

model AfkSetting {
 id         String  @id @db.VarChar
 guild      String  @db.VarChar
 maxLetters Int     @default(250)
 prefix     String? @db.VarChar

 ignoredChannels String[] @default([]) @db.VarChar
}
