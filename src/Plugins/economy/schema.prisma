//#region IGNORE

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

//#endregion

model EconomySetting {
 id    String @id @db.VarChar
 guild String @db.VarChar

 active        Boolean @default(false)
 frozen        Boolean @default(false)
 currencyName  String? @db.VarChar
 currencyEmote String? @db.VarChar

 startBalance Int @default(0)
 maxBalance   Int @default(0)

 messageAmount   Int     @default(1)
 messageCooldown Int     @default(60)
 messageDailyCap Int     @default(0)
 minTenureHours  Int     @default(0)

 transferActive   Boolean @default(false)
 transferMin      Int     @default(1)
 transferMax      Int     @default(0)
 transferDailyMax Int     @default(0)
 transferTax      Int     @default(0)

 balancePublic     Boolean @default(true)
 leaderboardPublic Boolean @default(true)

 denyChannels  String[] @db.VarChar
 denyRoles     String[] @db.VarChar
 denyUsers     String[] @db.VarChar
 allowChannels String[] @db.VarChar
 allowRoles    String[] @db.VarChar
 allowUsers    String[] @db.VarChar

 logChannels String[] @db.VarChar

 botToken String? @db.VarChar

 @@unique(guild)
}

model EconomyBalance {
 guild   String @db.VarChar
 user    String @db.VarChar
 balance Int    @default(0)

 earnedToday      Int @default(0)
 earnedEpoch      Int @default(0)
 transferredToday Int @default(0)
 transferredEpoch Int @default(0)

 firstSeenAt DateTime @default(now())

 @@id([guild, user])
 @@index([guild, balance])
}

model EconomyPurchase {
 id    String @id @db.VarChar
 guild String @db.VarChar
 user  String @db.VarChar
 item  String @db.VarChar
 price Int

 boughtAt DateTime @default(now())

 @@unique([guild, user, item])
 @@index([guild, user])
}

model EconomyPayout {
 key    String @id @db.VarChar
 guild  String @db.VarChar
 user   String @db.VarChar
 amount Int

 paidAt DateTime @default(now())

 @@index([guild, user])
}

model EconomyRoleReward {
 id    String @id @db.VarChar
 guild String @db.VarChar

 active    Boolean  @default(false)
 roles     String[] @db.VarChar
 denyRoles String[] @db.VarChar
 denyUsers String[] @db.VarChar

 currency Int @default(0)

 // TODO: move to levelling role rewards once levelling is migrated
 xpMultiplier Float @default(1)

 buyPrice         Int      @default(0) // 0 = not for sale
 purchaseRoles    String[] @db.VarChar
 customRoleReward String?  @db.VarChar // @crossplugin(custom-roles) RoleReward unlocked by buying this

 shopType ShopSurface @default(panel)

 panelChannel String? @db.VarChar
 panelMessage String? @db.VarChar

 panelEmbed      String? @db.VarChar
 panelComponents String? @db.VarChar

 panelButtonText  String?         @db.VarChar
 panelButtonEmote String?         @db.VarChar
 panelButtonStyle ShopButtonStyle @default(primary)

 payEvery        Int         @default(0) // 0 = none
 repeating       Boolean     @default(true)
 recurringAmount Int         @default(0)
 curve           PayoutCurve @default(linear)
 curveModifier   Int         @default(100)

 @@index(guild)
}

enum ShopSurface {
 command
 panel
}

enum ShopButtonStyle {
 primary
 secondary
 success
 danger
}

enum PayoutCurve {
 logarithmic
 linear
 quadratic
 cubic
 polynomial
 exponential
}

model EconomyRoleRewardProgress {
 guild  String @db.VarChar
 user   String @db.VarChar
 reward String @db.VarChar

 grantedAt    DateTime  @default(now())
 payouts      Int       @default(0)
 nextPayoutAt DateTime?

 @@id([guild, user, reward])
 @@index([nextPayoutAt])
 @@index([guild, user])
}

model EconomyRoleRewardEligibility {
 guild   String   @db.VarChar
 user    String   @db.VarChar
 rewards String[] @db.VarChar

 updatedAt DateTime @updatedAt

 @@id([guild, user])
 @@index(guild)
}

