//#region IGNORE

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

//#endregion

model WelcomeSetting {
 id    String @id @db.VarChar
 guild String @db.VarChar

 welcomeActive     Boolean  @default(false)
 welcomeChannel    String?  @db.VarChar
 welcomeEmbed      String?  @db.VarChar
 welcomeComponents String?  @db.VarChar
 welcomePingJoin   Boolean  @default(false)
 welcomePingRoles  String[] @db.VarChar
 welcomePingUsers  String[] @db.VarChar
 welcomeGifChannel String?  @db.VarChar

 goodbyeActive     Boolean  @default(false)
 goodbyeChannel    String?  @db.VarChar
 goodbyeEmbed      String?  @db.VarChar
 goodbyeComponents String?  @db.VarChar
 goodbyePingRoles  String[] @db.VarChar
 goodbyePingUsers  String[] @db.VarChar
 goodbyeGifChannel String?  @db.VarChar

 botToken      String?               @db.VarChar
 presenceType  PresenceActivityType?
 presenceText  String?               @db.VarChar
 presenceEmoji String?               @db.VarChar

 @@index(guild)
}

model WelcomeGif {
 id    String         @id @db.VarChar // mintId
 guild String         @db.VarChar
 kind  WelcomeGifKind
 url   String         @db.Text

 @@unique([guild, kind, url])
 @@index([guild, kind])
}

enum WelcomeGifKind {
 welcome
 goodbye
}
