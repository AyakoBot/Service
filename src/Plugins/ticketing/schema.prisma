//#region IGNORE

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

//#endregion

model TicketSetting {
 id     Decimal @id @db.Decimal
 guild  String  @db.VarChar
 active Boolean @default(false)

 // Decides whether to create threads in text-channels that support log creation
 logMode     TicketLogMode @default(Channel)
 // Text Channel or Forum Channel
 logChannels String[]      @db.VarChar
 // Forum tags applied to the log/staff post at each lifecycle step. A later step replaces the
 // previous step's tags; tagClaimer adds a per-claimer username tag that is never removed.
 createTags String[] @db.VarChar
 claimTags  String[] @db.VarChar
 closeTags  String[] @db.VarChar
 tagClaimer Boolean  @default(false)
 // If set, transcripts are also posted here (directly) when a ticket is deleted
 transcriptChannels String[] @db.VarChar

 // Only if type is dmToChannel or Channel
 archiveCategory String? @db.VarChar
 archiveDuration Decimal @default(60) @db.Decimal

 // Only need on dmToThread & Thread
 type                TicketType @default(Thread)
 channel             String?    @db.VarChar
 // Only need on dmToChannel & Channel
 category            String?    @db.VarChar
 // Only need on dmToThread & dmToChannel
 sendMessagePrefixes String[]   @db.Text

 // Only need on Thread & Channel
 allowCreatorClose Boolean @default(false)

 // Only on Channel & Thread (ignored on DM types). A private staff-only discussion thread per ticket.
 staffThreads Boolean @default(false)
 // Required when staffThreads is on AND type is Thread. Text or Forum channel hosting the staff thread.
 staffThreadsChannel String? @db.VarChar

 mentionRoles String[] @db.VarChar
 mentionUsers String[] @db.VarChar
 staffRoles String[] @db.VarChar
 staffUsers String[] @db.VarChar

 denyUsers String[] @db.VarChar
 denyRoles String[] @db.VarChar
 Ticket    Ticket[]

 @@index(guild)
 @@index(type)
}

model Ticket {
 id         Decimal     @id @db.Decimal
 dm         String?     @unique @db.VarChar
 starterDm  String?     @unique @db.VarChar
 user       String      @db.VarChar
 channel    String      @unique @db.VarChar
 settingsId Decimal     @db.Decimal
 state      TicketState @default(opened)

 settings TicketSetting @relation(fields: [settingsId], references: [id])

 @@index(dm)
 @@index(channel)
}

enum TicketState {
 opened
 closed
 claimed
 prepared
 deleted
}

enum TicketType {
 dmToThread
 dmToChannel
 Thread
 Channel
}

enum TicketLogMode {
 Channel
 Thread
}
