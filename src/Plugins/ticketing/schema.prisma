//#region IGNORE

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

//#endregion

model TicketSetting {
 id     Decimal @id @db.Decimal
 guild  String  @db.VarChar
 active Boolean @default(false)

 // Decides whether to create threads in text-channels that support log creation
 logMode     TicketLogMode @default(Channel)
 // Text Channel or Forum Channel
 logChannels String[]      @db.VarChar
 // Forum tags applied to the log/staff post at each lifecycle step. A later step replaces the
 // previous step's tags; tagClaimer adds a per-claimer username tag that is never removed.
 createTags String[] @db.VarChar
 claimTags  String[] @db.VarChar
 closeTags  String[] @db.VarChar
 tagClaimer Boolean  @default(false)
 // If set, transcripts are also posted here (directly) when a ticket is deleted
 transcriptChannels String[] @db.VarChar

 // Only if type is dmToChannel or Channel
 archiveCategory String? @db.VarChar
 archiveDuration Decimal @default(60) @db.Decimal

 // Only need on dmToThread & Thread
 type                TicketType @default(Thread)
 channel             String?    @db.VarChar
 // Only need on dmToChannel & Channel
 category            String?    @db.VarChar
 // Only need on dmToThread & dmToChannel
 sendMessagePrefixes String[]   @db.Text

 // Only need on Thread & Channel
 allowCreatorClose Boolean @default(false)

 // Only on Channel & Thread (ignored on DM types). A private staff-only discussion thread per ticket.
 staffThreads Boolean @default(false)
 // Required when staffThreads is on AND type is Thread. Text or Forum channel hosting the staff thread.
 staffThreadsChannel String? @db.VarChar

 mentionRoles String[] @db.VarChar
 mentionUsers String[] @db.VarChar
 staffRoles String[] @db.VarChar
 staffUsers String[] @db.VarChar

 denyUsers String[] @db.VarChar
 denyRoles String[] @db.VarChar

 // Whether tickets may also be opened through a mirrored DM conversation
 dmEnabled Boolean @default(false)

 // Panel intake message: channel/message ids, custom embed payload and the open-button label
 panelChannel     String? @db.VarChar
 panelMessage     String? @db.VarChar
 panelEmbed       Json?
 panelButtonLabel String? @db.VarChar

 // Reminder & inactivity thresholds in seconds (0 disables the respective timer)
 remindUnclaimedAfter Decimal @default(0) @db.Decimal
 remindUnclaimedEvery Decimal @default(0) @db.Decimal
 remindStaleAfter     Decimal @default(0) @db.Decimal
 remindStaleEvery     Decimal @default(0) @db.Decimal
 inactivityWarnAfter  Decimal @default(0) @db.Decimal
 inactivityCloseAfter Decimal @default(0) @db.Decimal
 // Targets pinged when a reminder fires
 remindRoles String[] @db.VarChar
 remindUsers String[] @db.VarChar

 // Per-plugin bot token (AES-256-GCM ciphertext, enc:v1: prefix; null falls back to the main bot)
 botToken String? @db.VarChar

 // Whether escalation tiers spread tickets across separate spaces or one unified forum
 placementMode TicketPlacementMode @default(SeparateSpaces)
 forumChannel  String?             @db.VarChar

 // Whether staff may take an already-claimed ticket
 allowTakeClaim Boolean  @default(false)
 // Per-tier staff roles (index = tier rank)
 staffTierRoles String[] @db.VarChar

 // Open-ticket caps (0 = unlimited)
 ticketLimitTotal Int @default(0)
 ticketLimitKind  Int @default(0)

 Ticket Ticket[]
 tiers  TicketTier[]

 @@index(guild)
 @@index(type)
}

model Ticket {
 id         Decimal     @id @db.Decimal
 dm         String?     @unique @db.VarChar
 starterDm  String?     @unique @db.VarChar
 user       String      @db.VarChar
 channel    String      @unique @db.VarChar
 settingsId Decimal     @db.Decimal
 state      TicketState @default(opened)

 // Pinned status surface message edited in place across the lifecycle
 surfaceMessage String? @db.VarChar
 // Current claimer and when the claim happened
 claimer   String?   @db.VarChar
 claimedAt DateTime?
 // Escalation priority shown on the surface
 priority TicketPriority @default(None)
 // Last human message timestamp, drives inactivity
 lastMessageAt DateTime?
 // Armed reminder fire time (epoch-ms)
 remindAt Decimal? @db.Decimal

 // Escalation tier this ticket currently sits in
 tierId Decimal?    @db.Decimal
 tier   TicketTier? @relation(fields: [tierId], references: [id])

 settings TicketSetting @relation(fields: [settingsId], references: [id])

 @@index(dm)
 @@index(channel)
 @@index(tierId)
}

model TicketPanel {
 id      Decimal @id @db.Decimal
 guild   String  @db.VarChar
 channel String? @db.VarChar
 message String? @db.VarChar
 embed   Json?
 kinds   Decimal[]

 @@index(guild)
}

model Snippets {
 id        Decimal  @id @db.Decimal
 guild     String   @db.VarChar
 name      String   @db.VarChar
 userText  String?  @db.Text
 staffText String?  @db.Text
 kinds     String[] @db.VarChar

 @@unique([guild, name])
 @@index(guild)
}

model TicketRoleMap {
 guild         String   @id @db.VarChar
 roleMapRoles  String[] @db.VarChar
 roleMapLabels String[] @db.Text

 @@index(guild)
}

model TicketTier {
 id              Decimal       @id @db.Decimal
 settingsId      Decimal       @db.Decimal
 name            String        @db.VarChar
 rank            Int
 claimRoles      String[]      @db.VarChar
 category        String?       @db.VarChar
 channel         String?       @db.VarChar
 reminderSeconds Decimal       @default(0) @db.Decimal
 settings        TicketSetting @relation(fields: [settingsId], references: [id])
 Ticket          Ticket[]

 @@unique([settingsId, rank])
 @@index(settingsId)
}

enum TicketState {
 opened
 closed
 claimed
 prepared
 deleted
}

enum TicketType {
 dmToThread
 dmToChannel
 Thread
 Channel
}

enum TicketLogMode {
 Channel
 Thread
}

enum TicketPriority {
 None
 Low
 Medium
 High
 Urgent
}

enum TicketPlacementMode {
 SeparateSpaces
 UnifiedForum
}
