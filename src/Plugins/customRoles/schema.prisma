//#region IGNORE

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

model EconomyRoleReward {
 id               String      @id @db.VarChar
 customRoleReward String?     @db.VarChar
 customRole       RoleReward? @relation(fields: [customRoleReward], references: [id], onDelete: SetNull)
}

//#endregion

model RoleReward {
 id    String @id @db.VarChar
 guild String @db.VarChar

 active    Boolean  @default(false)
 roles     String[] @db.VarChar
 denyRoles String[] @db.VarChar
 denyUsers String[] @db.VarChar

 customRole     Boolean @default(false)
 canSetColor    Boolean @default(true)
 canSetIcon     Boolean @default(true)
 canSetGradient Boolean @default(true)
 canSetHolo     Boolean @default(false)
 positionRole   String? @db.VarChar
 maxShare       Int     @default(0)

 notifyChannel String? @db.VarChar

 inactivityWipe  Boolean          @default(false)
 activitySources ActivitySource[] @default([Messages, Voice])
 inactiveAfter   Decimal          @default(2592000) @db.Decimal
 trackingSince   DateTime?

 economyRewards EconomyRoleReward[]

 @@index(guild)
}

enum RoleColorStyle {
 solid
 gradient
 holographic
}

model CustomRole {
 guild String   @db.VarChar
 user  String   @db.VarChar
 role  String   @db.VarChar
 shared String[] @db.VarChar

 style          RoleColorStyle @default(solid)
 primaryColor   Int?
 secondaryColor Int?
 tertiaryColor  Int?

 @@id([guild, user])
 @@index(guild)
 @@index(role)
}

model RoleRewardEligibility {
 guild   String   @db.VarChar
 user    String   @db.VarChar
 rewards String[] @db.VarChar
 updatedAt DateTime @updatedAt

 @@id([guild, user])
 @@index(guild)
}

enum ActivitySource {
 Messages
 Reactions
 Voice
 // TODO: request presence intent for this
 // Online
}

model LastActive {
 guild      String         @db.VarChar
 user       String         @db.VarChar
 source     ActivitySource
 lastActive DateTime       @default(now())

 @@id([guild, user, source])
 @@index([guild, user])
}
