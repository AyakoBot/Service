{
  "name": "@ayako/service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && pnpm tsc --emitDeclarationOnly && swc src -d dist --strip-leading-paths --copy-files",
    "dev": "pnpm build && node --enable-source-maps --experimental-wasm-modules --experimental-json-modules ./dist/index.js --log-level=info --local",
    "postinstall": "mkdir -p ./logs",
    "lint": "eslint src --fix",
    "register": "node ./dist/register-commands.js",
    "register-dev": "pnpm build && node ./dist/register-commands-dev.js",
    "run": "node --max-old-space-size=15360 --no-deprecation --no-warnings --experimental-json-modules ./dist/index.js",
    "start": "pnpm run run",
    "watch": "swc src -d dist --strip-leading-paths --copy-files --watch"
  },
  "exports": {
   ".": "./dist/index.js",
   "./*": "./dist/*"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/core": "^2.4.0",
    "@discordjs/rest": "^2.6.1",
    "@prisma/adapter-pg": "^7.7.0",
    "canvas": "^3.2.3",
    "captcha-canvas": "^3.4.0",
    "discord-api-types": "0.38.48",
    "dotenv": "^17.4.1",
    "echarts": "^6.0.0",
    "glob": "^13.0.6",
    "ioredis": "^5.10.1",
    "lodash.merge": "^4.6.2",
    "longjohn": "^0.2.12",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "ms": "^2.1.3",
    "nekos-best.js": "^6.5.2",
    "node-schedule": "^2.1.1",
    "os": "^0.1.2",
    "prom-client": "^15.1.3",
    "purrbot-api": "^1.5.1",
    "string-similarity": "^4.0.4",
    "waifu-pics-api": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.15.24",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/clone": "^2.1.4",
    "@types/echarts": "^5.0.0",
    "@types/glob": "^9.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/moment-duration-format": "^2.2.7",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/node-schedule": "^2.1.8",
    "@types/source-map-support": "^0.5.10",
    "@types/string-similarity": "^4.0.2",
    "eslint": "^10.2.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.6.0"
  }
}
