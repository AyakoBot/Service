{
  "name": "@ayako/service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm tsc --emitDeclarationOnly && swc src -d dist --strip-leading-paths --copy-files",
    "dev": "pnpm build && node --enable-source-maps --experimental-wasm-modules --experimental-json-modules ./dist/index.js --log-level=info --local",
    "lint": "eslint src --fix",
    "register": "node ./dist/register-commands.js",
    "register-dev": "pnpm build && node ./dist/register-commands-dev.js",
    "run": "node --no-deprecation --no-warnings --experimental-json-modules ./dist/index.js",
    "start": "pnpm run run",
    "watch": "swc src -d dist --strip-leading-paths --copy-files --watch"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/core": "^2.5.0",
    "@discordjs/rest": "^2.6.1",
    "@prisma/adapter-pg": "7.8.0",
    "canvas": "^3.2.3",
    "captcha-canvas": "^3.4.0",
    "discord-api-types": "0.38.49",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "glob": "^13.0.6",
    "ioredis": "^5.11.1",
    "lodash.merge": "^4.6.2",
    "longjohn": "^0.2.12",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "ms": "^2.1.3",
    "nekos-best.js": "^6.5.3",
    "node-schedule": "^2.1.1",
    "os": "^0.1.2",
    "prom-client": "^15.1.3",
    "purrbot-api": "^1.5.1",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.15.43",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/clone": "^2.1.4",
    "@types/echarts": "^5.0.0",
    "@types/glob": "^9.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/moment-duration-format": "^2.2.7",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/node-schedule": "^2.1.8",
    "@types/source-map-support": "^0.5.10",
    "@types/string-similarity": "^4.0.2",
    "eslint": "^10.5.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=25.6.0",
    "pnpm": ">=11.6.0"
  }
}
